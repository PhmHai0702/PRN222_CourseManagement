@page "/"
@using System.Text.Json
@using CourseManagement.Model.DTOs
@using Microsoft.AspNetCore.WebUtilities
@inject IAppNotificationService _mess
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager _nav

<PageTitle>EduPath — Học kỹ năng, mở tương lai</PageTitle>

<section class="hero">
    <div class="hero-inner">
        <div class="hero-copy">
            <span class="eyebrow"><i></i> Nền tảng học lập trình thực chiến</span>
            <h1>Học đúng kỹ năng.<br/><em>Đi xa hơn.</em></h1>
            <p>Khóa học được xây dựng theo lộ trình rõ ràng, bài tập thực tế và nội dung cập nhật cho công việc.</p>
            <div class="hero-actions">
                <a href="#pro-courses" class="primary-cta">Khám phá khóa học <Icon Type="arrow-right" /></a>
                <NavLink href="vip-subscription" class="secondary-cta"><Icon Type="crown" /> Xem quyền lợi Pro</NavLink>
            </div>
            <div class="trust-row"><span><b>4.8/5</b> đánh giá học viên</span><span><b>10K+</b> lượt học</span><span><b>50+</b> bài học thực tế</span></div>
        </div>
        <div class="hero-visual" aria-hidden="true">
            <div class="code-window">
                <div class="window-bar"><span></span><span></span><span></span><small>learning.js</small></div>
                <pre><span class="purple">const</span> future = <span class="blue">await</span> learn({
  skill: <span class="orange">"Web Development"</span>,
  practice: <span class="blue">true</span>,
  consistency: <span class="orange">"every day"</span>
});

future.<span class="green">unlock</span>();</pre>
            </div>
            <div class="floating-card"><Icon Type="check-circle" Theme="IconThemeType.Fill"/><div><b>Hoàn thành bài học</b><small>JavaScript căn bản</small></div></div>
        </div>
    </div>
</section>

<section class="category-strip">
    <div><span>Chu de noi bat</span><a href="#free-courses">Lap trinh Web</a><a href="#free-courses">JavaScript</a><a href="#free-courses">React</a><a href="#free-courses">Backend</a><a href="/listBlog">Kinh nghiem nghe nghiep</a></div>
</section>

<main class="home-content">
    <section id="pro-courses" class="course-section">
        <div class="section-heading"><div><span class="section-kicker">HỌC SÂU HƠN VỚI PRO</span><h2>Khóa học được yêu thích</h2><p>Nội dung chuyên sâu, đi từ nền tảng đến dự án hoàn chỉnh.</p></div><NavLink href="vip-subscription">Tìm hiểu gói Pro <Icon Type="arrow-right" /></NavLink></div>
        <div class="course-grid">
            @if (LoadingCourseProList) { <div class="loading-state">Đang tải khóa học...</div> }
            else if (ListCoursePro != null) { @foreach (var course in ListCoursePro) { @CourseTile(course, true) } }
        </div>
    </section>

    <section id="free-courses" class="course-section free-section">
        <div class="section-heading"><div><span class="section-kicker free">BẮT ĐẦU MIỄN PHÍ</span><h2>Xây nền tảng thật vững</h2><p>Học thử ngay hôm nay, không cần thanh toán.</p></div></div>
        <div class="course-grid">
            @if (LoadingCourseFreeList) { <div class="loading-state">Đang tải khóa học...</div> }
            else if (ListCourseFree != null) { @foreach (var course in ListCourseFree) { @CourseTile(course, false) } }
        </div>
    </section>
</main>

@code {
    bool LoadingCourseProList = true, LoadingCourseFreeList = true;
    HttpClient httpClient = default!;
    private List<SearchCourseResponse>? ListCoursePro, ListCourseFree;
    private readonly JsonSerializerOptions jsonOptions = new() { PropertyNameCaseInsensitive = true };

    protected override async Task OnInitializedAsync() {
        httpClient = HttpClientFactory.CreateClient("Auth");
        await Task.WhenAll(FetchCourses(1), FetchCourses(0));
        var query = QueryHelpers.ParseQuery(new Uri(_nav.Uri).Query);
        if (query.TryGetValue("error", out var error)) { await _mess.Error(error.ToString()); _nav.NavigateTo("/", replace:true); }
    }
    async Task FetchCourses(int type) {
        try {
            var response = await httpClient.GetAsync($"/api/Course/search?CourseTypes={type}&Statuss=1");
            if (!response.IsSuccessStatusCode) { await _mess.Error("Không thể tải danh sách khóa học"); return; }
            var courses = JsonSerializer.Deserialize<List<SearchCourseResponse>>(await response.Content.ReadAsStringAsync(), jsonOptions);
            if (type == 1) ListCoursePro = courses; else ListCourseFree = courses;
        } catch (Exception ex) { await _mess.Error($"Lỗi tải khóa học: {ex.Message}"); }
        finally { if (type == 1) LoadingCourseProList=false; else LoadingCourseFreeList=false; }
    }
}

@code {
    RenderFragment CourseTile(SearchCourseResponse Course, bool IsPro) => @<article class="course-tile" @onclick="() => OpenCourse(Course.Id)">
        <div class="tile-image"><img src="@Course.PreviewImage" alt="@Course.Title" loading="lazy"/><span class="level">@Course.LevelName</span>@if(IsPro){<span class="pro-badge"><Icon Type="crown"/> PRO</span>}<button aria-label="Xem khóa học"><Icon Type="arrow-right" /></button></div>
        <div class="tile-body"><div class="tile-category">@Course.CategoryName</div><h3>@Course.Title</h3><p>@Course.Description</p><div class="tile-meta"><span><Icon Type="play-circle"/> @Course.TotalLesson bài</span><span><Icon Type="clock-circle"/> @FormatDuration(Course.TotalTime)</span><span><Icon Type="user"/> @Course.TotalEnrolled</span></div></div>
    </article>;
    void OpenCourse(string id) => _nav.NavigateTo($"/preview/{id}");
    static string FormatDuration(TimeSpan value) => value.TotalHours >= 1 ? $"{Math.Floor(value.TotalHours)}g {value.Minutes}p" : $"{value.Minutes} phút";
}

