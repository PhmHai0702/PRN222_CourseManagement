@page "/vip-subscription"
@using BlazorAppSecure.Model
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Forms
@using CourseManagement.Model.Constant
@using CourseManagement.Model.Model
@using CourseManagement.Model.ViewModel
@inject NavigationManager Navigation
@inject IHttpClientFactory HttpClientFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAppNotificationService _mess

<PageTitle>Gói Pro — EduPath</PageTitle>

<section class="pro-hero">
    <span class="pro-kicker"><Icon Type="crown" /> EDUPATH PRO</span>
    <h1>Đầu tư cho kỹ năng<br/><em>đáng giá nhất của bạn.</em></h1>
    <p>Truy cập toàn bộ khóa học chuyên sâu và học theo tốc độ của riêng bạn.</p>
</section>

<main class="pricing-container">
    <div class="pricing-grid">
        @foreach (var plan in Plans) {
            <article class="price-card @(_vipModel.Package == plan.Months ? "selected" : "") @(plan.IsPopular ? "popular" : "")"
                     @onclick="() => SelectPlan(plan.Months)">
                @if (plan.IsPopular) { <span class="popular-label">ĐƯỢC CHỌN NHIỀU</span> }
                <div class="plan-radio"><span></span></div>
                <span class="plan-name">@plan.Name</span>
                <div class="plan-price"><b>@plan.Price.ToString("N0", new System.Globalization.CultureInfo("vi-VN"))</b><span>₫</span></div>
                <small>@plan.MonthlyText</small>
                <div class="plan-divider"></div>
                <ul>
                    <li><Icon Type="check" /> Toàn bộ khóa học Pro</li>
                    <li><Icon Type="check" /> Học không giới hạn thời gian</li>
                    <li><Icon Type="check" /> Nội dung và bài học mới</li>
                    <li><Icon Type="check" /> Theo dõi tiến độ cá nhân</li>
                </ul>
            </article>
        }
    </div>

    <div class="checkout-bar">
        <div><span>Gói đã chọn</span><b>@SelectedPlanText</b></div>
        <Button Type="ButtonType.Primary" Size="ButtonSize.Large" Loading="@isProcessing" OnClick="StartPayment">
            Tiếp tục thanh toán <Icon Type="arrow-right" />
        </Button>
        <small><Icon Type="safety-certificate" /> Thanh toán an toàn qua VNPay</small>
    </div>
</main>

<section class="pro-note"><span>Học không giới hạn</span><i></i><span>Hủy bất cứ lúc nào</span><i></i><span>Cập nhật nội dung liên tục</span></section>

@code {
    private HttpClient httpClient = default!;
    private readonly VipModel _vipModel = new();
    private bool isProcessing;
    private readonly List<PlanOption> Plans = new() {
        new("1", "Gói 1 tháng", 100000, "100.000 ₫ / tháng", false),
        new("3", "Gói 3 tháng", 250000, "Chỉ 83.333 ₫ / tháng", true),
        new("6", "Gói 6 tháng", 450000, "Chỉ 75.000 ₫ / tháng", false),
        new("12", "Gói 12 tháng", 800000, "Chỉ 66.667 ₫ / tháng", false)
    };
    private string SelectedPlanText => Plans.FirstOrDefault(x => x.Months == _vipModel.Package)?.Name ?? "Chưa chọn gói";

    protected override Task OnInitializedAsync() { httpClient = HttpClientFactory.CreateClient("Auth"); return Task.CompletedTask; }
    private void SelectPlan(string months) => _vipModel.Package = months;
    private async Task StartPayment() => await OnFinish(new EditContext(_vipModel));

    private async Task OnFinish(EditContext editContext) {
        var selected = Plans.FirstOrDefault(x => x.Months == _vipModel.Package);
        if (selected is null) { await _mess.Error("Vui lòng chọn một gói Pro!"); return; }
        try {
            isProcessing = true;
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated != true) {
                await _mess.Error("Vui lòng đăng nhập để tiếp tục thanh toán.");
                Navigation.NavigateTo("/login", true); return;
            }
            var userEmail = authState.User.FindFirst(ClaimTypes.Email)?.Value;
            if (string.IsNullOrWhiteSpace(userEmail)) { await _mess.Error("Không tìm thấy thông tin người dùng."); return; }

            var order = new OrderCreateVM {
                TotalAmount = selected.Price, PurchasedPlan = VipStatus.Premium, VipPrice = selected.Price,
                VipExpirationDate = DateTime.Now.AddMonths(int.Parse(selected.Months))
            };
            var orderResponse = await httpClient.PostAsJsonAsync("/api/Order/create", order);
            if (!orderResponse.IsSuccessStatusCode) { await _mess.Error($"Không thể tạo đơn hàng: {await orderResponse.Content.ReadAsStringAsync()}"); return; }
            var savedOrder = await orderResponse.Content.ReadFromJsonAsync<Order>();
            if (savedOrder is null) { await _mess.Error("Không nhận được thông tin đơn hàng."); return; }

            var payment = new VnPaymentRequestModel {
                OrderId = savedOrder.Id, ProductName = $"Gói Pro {selected.Months} tháng", Amount = (double)selected.Price,
                Description = $"VIP-{selected.Price}-{userEmail}-{savedOrder.Id}"
            };
            var response = await httpClient.PostAsJsonAsync("/api/Payment/create", payment);
            if (!response.IsSuccessStatusCode) { await _mess.Error($"Không thể tạo thanh toán: {await response.Content.ReadAsStringAsync()}"); return; }
            Navigation.NavigateTo(await response.Content.ReadAsStringAsync(), true);
        } catch (Exception ex) { await _mess.Error($"Lỗi khi tạo thanh toán: {ex.Message}"); }
        finally { isProcessing = false; }
    }

    private sealed record PlanOption(string Months, string Name, decimal Price, string MonthlyText, bool IsPopular);
    private sealed class VipModel { public string? Package { get; set; } }
}

