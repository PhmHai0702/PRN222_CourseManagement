lex;gap:9px}.price-card li .anticon{color:#238352}.checkout-bar{max-width:650px;margin:36px auto 0;display:grid;grid-template-columns:1fr auto;align-items:center;gap:12px;padding:17px 20px;border:1px solid #e0e5e1;border-radius:12px;background:white;box-shadow:0 10px 30px rgba(24,45,31,.06)}.checkout-bar>div{display:flex;flex-direction:column}.checkout-bar>div span{color:#87918b;font-size:10px;text-transform:uppercase;letter-spacing:.8px}.checkout-bar>div b{color:#26332b}.checkout-bar .ant-btn{height:46px;border:0;border-radius:8px;background:#176b45;font-weight:700}.checkout-bar>small{grid-column:1/-1;text-align:center;color:#8a948e;font-size:10px}.pro-note{display:flex;justify-content:center;align-items:center;gap:22px;padding:25px;background:#17211b;color:#cbd4ce;font-size:12px}.pro-note i{width:3px;height:3px;border-radius:50%;background:#637169}@@media(max-width:960px){.pricing-grid{grid-template-columns:repeat(2,1fr)}}@@media(max-width:580px){.pro-hero{padding:55px 18px 120px}.pro-hero h1{font-size:38px}.pricing-container{padding:0 16px 55px}.pricing-grid{grid-template-columns:1fr}.price-card{min-height:350px}.checkout-bar{grid-template-columns:1fr}.checkout-bar .ant-btn{width:100%}.pro-note{flex-wrap:wrap}}
</style>
