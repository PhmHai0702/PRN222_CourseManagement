@page "/listBlog"
@using AntDesign
@using BlazorAppSecure.Model
@using BlazorAppSecure.Sevices.Blog
@using System.Text.RegularExpressions
@inject NavigationManager NavigationManager
@inject IBlogService BlogService
@inject IAppNotificationService _message

<PageTitle>Thế giới lập trình — EduPath</PageTitle>

<section class="journal-hero">
    <div class="journal-hero-inner">
        <div>
            <span class="journal-kicker">EDUPATH JOURNAL</span>
            <h1>Thế giới lập trình</h1>
            <p>Góc chia sẻ kiến thức, kinh nghiệm nghề nghiệp và những câu chuyện thật trên hành trình trở thành lập trình viên.</p>
        </div>
        <div class="hero-symbol" aria-hidden="true"><span>&lt;/&gt;</span></div>
    </div>
</section>

<main class="journal-container">
    <div class="journal-toolbar">
        <div class="toolbar-heading"><span>Bài viết mới</span><small>@blogList.Count bài viết</small></div>
        <div class="filters">
            <div class="filter-control">
                <Icon Type="swap" />
                <Select TItem="string" TItemValue="string" DefaultValue="@sortBy" OnSelectedItemChanged="OnSortChanged" Bordered="false" Style="width: 145px;">
                    <SelectOptions>
                        <SelectOption TItem="string" TItemValue="string" Value="@("newest")" Label="Mới nhất" />
                        <SelectOption TItem="string" TItemValue="string" Value="@("oldest")" Label="Cũ nhất" />
                        <SelectOption TItem="string" TItemValue="string" Value="@("most_viewed")" Label="Xem nhiều nhất" />
                        <SelectOption TItem="string" TItemValue="string" Value="@("least_viewed")" Label="Xem ít nhất" />
                    </SelectOptions>
                </Select>
            </div>
            <div class="filter-control">
                <Icon Type="appstore" />
                <Select TItem="int?" TItemValue="int?" DefaultValue="@selectedCategoryId" OnSelectedItemChanged="OnCategoryChanged"
                        Bordered="false" Style="width: 165px;" AllowClear Placeholder="Tất cả chủ đề">
                    <SelectOptions>
                        @foreach (var category in categories) {
                            <SelectOption TItem="int?" TItemValue="int?" Value="@category.Id" Label="@category.Name" />
                        }
                    </SelectOptions>
                </Select>
            </div>
        </div>
    </div>

    @if (loading) {
        <div class="loading-wrap"><Spin /><span>Đang tải bài viết...</span></div>
    } else if (!blogList.Any()) {
        <div class="empty-state"><Icon Type="file-search" /><h2>Chưa có bài viết phù hợp</h2><p>Hãy thử chọn một chủ đề hoặc cách sắp xếp khác.</p></div>
    } else {
        <section class="article-grid">
            @foreach (var blog in blogList) {
                <article class="article-card" @onclick="() => NavigateToDetail(blog.Id)">
                    <div class="article-accent"><span>@GetCategoryLabel(blog)</span><b>@GetDecorativeNumber(blog.Id)</b></div>
                    <div class="article-content">
                        <div class="article-author"><span class="author-avatar">E</span><span>EduPath Team</span><i></i><time>@blog.CreatedAt.ToString("dd/MM/yyyy")</time></div>
                        <h2>@blog.Title</h2>
                        <p>@GetExcerpt(blog.Content)</p>
                        <div class="article-footer">
                            <div class="tag-list">
                                @if (blog.Categories?.Any() == true) {
                                    @foreach (var category in blog.Categories.Take(2)) { <span>@category.Name</span> }
                                } else { <span>Lập trình</span> }
                            </div>
                            <div class="article-meta"><span><Icon Type="clock-circle" /> @CalculateReadingTime(blog.Content) phút đọc</span><span><Icon Type="eye" /> @blog.ViewCount</span></div>
                        </div>
                    </div>
                    <button class="read-button" aria-label="Đọc bài viết"><Icon Type="arrow-right" /></button>
                </article>
            }
        </section>
    }
</main>

@code {
    private List<CategoiesModel> categories = new();
    private List<BlogModel> blogList = new();
    private bool loading = true;
    private string sortBy = "newest";
    private int? selectedCategoryId;

    protected override async Task OnInitializedAsync() {
        try { await Task.WhenAll(LoadBlogs(), LoadCategories()); }
        catch (Exception ex) { await _message.Error($"Lỗi khi tải dữ liệu: {ex.Message}"); }
        finally { loading = false; }
    }
    private async Task LoadCategories() => categories = await BlogService.GetCategories() ?? new();
    private async Task LoadBlogs() => blogList = await BlogService.GetBlogList(sortBy, selectedCategoryId) ?? new();
    private async Task OnSortChanged(string value) { sortBy = value; loading = true; await LoadBlogs(); loading = false; }
    private async Task OnCategoryChanged(int? value) { selectedCategoryId = value; loading = true; await LoadBlogs(); loading = false; }
    private void NavigateToDetail(int id) => NavigationManager.NavigateTo($"/listblogs/detail/{id}");
    private static int CalculateReadingTime(string content) => Math.Max(1, (int)Math.Ceiling(StripHtml(content).Split(' ', StringSplitOptions.RemoveEmptyEntries).Length / 200d));
    private static string GetExcerpt(string content) { var text = StripHtml(content); return text.Length > 145 ? text[..145].Trim() + "…" : text; }
    private static string StripHtml(string content) => Regex.Replace(content ?? "", "<[^>]+>", " ").Replace("&nbsp;", " ").Trim();
    private static string GetCategoryLabel(BlogModel blog) => blog.Categories?.FirstOrDefault()?.Name?.ToUpperInvariant() ?? "JOURNAL";
    private static string GetDecorativeNumber(int id) => (id % 100).ToString("00");
}

