@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="learning-shell">
    <header class="topbar">
        <div class="topbar-inner">
            <NavLink href="" Match="NavLinkMatch.All" class="brand" aria-label="EduPath - Trang chủ">
                <span class="brand-mark"><Icon Type="book" Theme="IconThemeType.Fill" /></span>
                <span>Edu<span>Path</span></span>
            </NavLink>

            <button type="button" class="menu-toggle" aria-label="Mở menu" aria-expanded="@menuOpen" @onclick="ToggleMenu">
                <Icon Type="@(menuOpen ? "close" : "menu")" />
            </button>

            <nav class="primary-nav @(menuOpen ? "is-open" : null)" aria-label="Điều hướng chính">
                <NavLink href="" Match="NavLinkMatch.All" @onclick="CloseMenu">Trang chủ</NavLink>
                <a href="/#pro-courses" @onclick="CloseMenu">Khóa học</a>
                <NavLink href="listBlog" @onclick="CloseMenu">Thế giới lập trình</NavLink>
                <NavLink href="vip-subscription" @onclick="CloseMenu">Gói Pro</NavLink>
            </nav>

            <div class="header-actions">
                <AuthorizeView>
                    <Authorized>
                        <span class="user-name">@context.User.Identity?.Name</span>
                        <Dropdown Trigger="@(new Trigger[] { Trigger.Click })">
                            <Overlay>
                                <Menu>
                                    <MenuItem><NavLink href="manage/profile">Hồ sơ của tôi</NavLink></MenuItem>
                                    <AuthorizeView Roles="Admin" Context="adminState">
                                        <Authorized><MenuItem><NavLink href="courses">Quản trị</NavLink></MenuItem></Authorized>
                                    </AuthorizeView>
                                    <MenuItem><NavLink href="logout">Đăng xuất</NavLink></MenuItem>
                                </Menu>
                            </Overlay>
                            <ChildContent><Avatar Icon="user" Class="user-avatar" /></ChildContent>
                        </Dropdown>
                    </Authorized>
                    <NotAuthorized>
                        <NavLink href="login" class="login-link">Đăng nhập</NavLink>
                        <NavLink href="register" class="signup-link">Đăng ký</NavLink>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </header>

    <AuthorizeView Roles="Admin">
        <Authorized>
            <nav class="admin-nav" aria-label="Quản trị">
                <span>Quản trị</span>
                <NavLink href="users">Người dùng</NavLink>
                <NavLink href="courses">Khóa học</NavLink>
                <NavLink href="blogs">Bài viết</NavLink>
                <NavLink href="orders">Đơn hàng</NavLink>
            </nav>
        </Authorized>
    </AuthorizeView>

    <main class="page-content">@Body</main>

    <footer class="site-footer">
        <div class="footer-main">
            <div class="footer-brand">
                <NavLink href="" class="brand" aria-label="EduPath - Trang chủ">
                    <span class="brand-mark"><Icon Type="book" Theme="IconThemeType.Fill" /></span>
                    <span>Edu<span>Path</span></span>
                </NavLink>
                <p>Học kỹ năng công nghệ theo lộ trình thực tế, tiến bộ từng ngày.</p>
            </div>
            <div class="footer-links">
                <div><b>Khám phá</b><a href="/#pro-courses">Khóa học Pro</a><a href="/#free-courses">Khóa học miễn phí</a></div>
                <div><b>Cộng đồng</b><NavLink href="listBlog">Thế giới lập trình</NavLink><NavLink href="register">Tham gia EduPath</NavLink></div>
                <div><b>Tài khoản</b><NavLink href="manage/profile">Hồ sơ học tập</NavLink><NavLink href="vip-subscription">Nâng cấp Pro</NavLink></div>
            </div>
        </div>
        <div class="footer-bottom"><span>© @DateTime.Now.Year EduPath. Học thực tế, tiến bộ thật.</span><span>Được xây dựng với ASP.NET Core &amp; Blazor</span></div>
    </footer>
</div>

@code {
    private bool menuOpen;
    private void ToggleMenu() => menuOpen = !menuOpen;
    private void CloseMenu() => menuOpen = false;
}

<style>
    :root { --ink:#17211b; --muted:#66736b; --green:#176b45; --green-dark:#0e4e32; --cream:#f5f3ec; --line:#e4e8e4; }
    .learning-shell { min-height:100vh; background:#fff; color:var(--ink); }
    .topbar { position:sticky; top:0; z-index:1000; height:72px; background:rgba(255,255,255,.94); border-bottom:1px solid rgba(23,33,27,.09); backdrop-filter:blur(14px); }
    .topbar-inner { max-width:1280px; height:100%; margin:auto; padding:0 28px; display:flex; align-items:center; gap:38px; }
    .brand { display:flex; align-items:center; gap:10px; color:var(--ink)!important; font-size:22px; font-weight:800; letter-spacing:-.7px; text-decoration:none!important; white-space:nowrap; }
    .brand>span:last-child>span { color:var(--green); }
    .brand-mark { width:36px; height:36px; display:grid; place-items:center; border-radius:10px; background:var(--green); color:white; transform:rotate(-3deg); }
    .menu-toggle { display:none; width:40px; height:40px; padding:0; border:1px solid var(--line); border-radius:9px; background:#fff; color:var(--ink); font-size:18px; cursor:pointer; }
    .primary-nav { display:flex; align-items:center; gap:30px; flex:1; height:100%; }
    .primary-nav a { position:relative; display:flex; align-items:center; height:100%; color:#3f4b44; font-size:14px; font-weight:600; text-decoration:none; white-space:nowrap; }
    .primary-nav a:hover,.primary-nav a.active { color:var(--green); }
    .primary-nav a.active:after { content:""; position:absolute; left:0; right:0; bottom:0; height:3px; border-radius:3px 3px 0 0; background:var(--green); }
    .courses-link.active:after { display:none; }
    .header-actions { display:flex; align-items:center; gap:14px; white-space:nowrap; }
    .user-name { max-width:170px; overflow:hidden; text-overflow:ellipsis; font-size:13px; color:var(--muted); }
    .user-avatar { cursor:pointer; background:var(--green)!important; transition:transform .2s ease; }
    .user-avatar:hover { transform:scale(1.06); }
    .login-link,.signup-link { padding:9px 14px; font-weight:650; text-decoration:none!important; border-radius:8px; }
    .login-link { color:var(--ink)!important; }
    .signup-link { color:white!important; background:var(--green); }
    .signup-link:hover { background:var(--green-dark); transform:translateY(-1px); }
    .admin-nav { min-height:44px; display:flex; align-items:center; justify-content:center; gap:24px; padding:7px 20px; background:#17211b; color:white; font-size:13px; }
    .admin-nav span { color:#a8b4ad; text-transform:uppercase; font-size:10px; font-weight:800; letter-spacing:1.3px; }
    .admin-nav a { color:#e9eeeb; text-decoration:none; }
    .admin-nav a:hover,.admin-nav a.active { color:#8fe0b3; }
    .page-content { min-height:calc(100vh - 72px); }
    .site-footer { background:#14251c; color:#dce6e0; }
    .footer-main { max-width:1220px; margin:auto; padding:56px 28px 42px; display:grid; grid-template-columns:1.1fr 1.9fr; gap:70px; }
    .site-footer .brand { color:white!important; width:max-content; }
    .footer-brand p { max-width:330px; margin:19px 0 0; color:#9fb0a6; font-size:14px; line-height:1.7; }
    .footer-links { display:grid; grid-template-columns:repeat(3,1fr); gap:36px; }
    .footer-links>div { display:flex; flex-direction:column; align-items:flex-start; gap:12px; }
    .footer-links b { margin-bottom:3px; color:#fff; font-size:13px; }
    .footer-links a { color:#aebdb4; font-size:13px; text-decoration:none; transition:color .2s ease; }
    .footer-links a:hover { color:#8fe0b3; }
    .footer-bottom { max-width:1220px; margin:auto; padding:20px 28px; border-top:1px solid rgba(255,255,255,.09); display:flex; justify-content:space-between; gap:20px; color:#809188; font-size:11px; }
    @@media(max-width:860px){ .topbar-inner{padding:0 16px;gap:18px}.primary-nav{gap:18px;overflow-x:auto}.primary-nav a{font-size:13px}.user-name{display:none} }
    @@media(max-width:700px){
        .topbar{height:64px}.topbar-inner{height:64px;gap:10px}.menu-toggle{display:grid;place-items:center;margin-left:auto;order:2}.header-actions{order:3}.primary-nav{position:absolute;top:64px;left:12px;right:12px;height:auto;padding:10px;display:none;flex-direction:column;align-items:stretch;gap:2px;overflow:visible;background:white;border:1px solid var(--line);border-radius:0 0 12px 12px;box-shadow:0 18px 34px rgba(18,39,26,.14)}.primary-nav.is-open{display:flex}.primary-nav a{height:auto;padding:12px 13px;border-radius:7px}.primary-nav a:hover,.primary-nav a.active{background:#f0f6f2}.primary-nav a.active:after{display:none}.page-content{padding-top:0}.brand{font-size:19px}.brand-mark{width:32px;height:32px}.login-link{display:none}.signup-link{padding:8px 11px}.footer-main{grid-template-columns:1fr;gap:35px;padding:44px 20px 32px}.footer-links{grid-template-columns:repeat(2,1fr)}.footer-bottom{padding:18px 20px;flex-direction:column;gap:6px}
    }
    @@media(max-width:440px){.signup-link{display:none}.footer-links{grid-template-columns:1fr 1fr;gap:28px 18px}}
</style>
