@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="learning-shell">
    <header class="topbar">
        <div class="topbar-inner">
            <NavLink href="" Match="NavLinkMatch.All" class="brand" aria-label="EduPath - Trang chủ">
                <span class="brand-mark"><Icon Type="book" Theme="IconThemeType.Fill" /></span>
                <span>Edu<span>Path</span></span>
            </NavLink>

            <nav class="primary-nav" aria-label="Điều hướng chính">
                <NavLink href="" Match="NavLinkMatch.All">Trang chủ</NavLink>
                <NavLink href="" Match="NavLinkMatch.All" class="courses-link">Khóa học</NavLink>
                <NavLink href="compare-courses">So sánh khóa học</NavLink>
                <NavLink href="listBlog">Thế giới lập trình</NavLink>
                <NavLink href="vip-subscription">Gói Pro</NavLink>
            </nav>

            <div class="header-actions">
                <AuthorizeView>
                    <Authorized>
                        <span class="user-name">@context.User.Identity?.Name</span>
                        <Dropdown Trigger="@(new Trigger[] { Trigger.Click })">
                            <Overlay>
                                <Menu>
                                    <MenuItem><NavLink href="manage/profile">Hồ sơ của tôi</NavLink></MenuItem>
                                    <MenuItem><NavLink href="my-learning">Tiến độ học tập</NavLink></MenuItem>
                                    <AuthorizeView Roles="Admin" Context="adminState">
                                        <Authorized><MenuItem><NavLink href="courses">Quản trị</NavLink></MenuItem></Authorized>
                                    </AuthorizeView>
                                    <MenuItem><NavLink href="logout">Đăng xuất</NavLink></MenuItem>
                                </Menu>
                            </Overlay>
                            <ChildContent><Avatar Icon="user" Class="user-avatar" /></ChildContent>
                        </Dropdown>
                    </Authorized>
                    <NotAuthorized>
                        <NavLink href="login" class="login-link">Đăng nhập</NavLink>
                        <NavLink href="register" class="signup-link">Đăng ký</NavLink>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </header>

    <AuthorizeView Roles="Admin">
        <Authorized>
            <nav class="admin-nav" aria-label="Quản trị">
                <span>Quản trị</span>
                <NavLink href="users">Người dùng</NavLink>
                <NavLink href="courses">Khóa học</NavLink>
                <NavLink href="blogs">Bài viết</NavLink>
                <NavLink href="orders">Đơn hàng</NavLink>
            </nav>
        </Authorized>
    </AuthorizeView>

    <main class="page-content">@Body</main>
</div>

<style>
    :root { --ink:#17211b; --muted:#66736b; --green:#176b45; --green-dark:#0e4e32; --cream:#f5f3ec; --line:#e4e8e4; }
    .learning-shell { min-height:100vh; background:#fff; color:var(--ink); }
    .topbar { position:sticky; top:0; z-index:1000; height:72px; background:rgba(255,255,255,.94); border-bottom:1px solid rgba(23,33,27,.09); backdrop-filter:blur(14px); }
    .topbar-inner { max-width:1280px; height:100%; margin:auto; padding:0 28px; display:flex; align-items:center; gap:38px; }
    .brand { display:flex; align-items:center; gap:10px; color:var(--ink)!important; font-size:22px; font-weight:800; letter-spacing:-.7px; text-decoration:none!important; white-space:nowrap; }
    .brand>span:last-child>span { color:var(--green); }
    .brand-mark { width:36px; height:36px; display:grid; place-items:center; border-radius:10px; background:var(--green); color:white; transform:rotate(-3deg); }
    .primary-nav { display:flex; align-items:center; gap:30px; flex:1; height:100%; }
    .primary-nav a { position:relative; display:flex; align-items:center; height:100%; color:#3f4b44; font-size:14px; font-weight:600; text-decoration:none; white-space:nowrap; }
    .primary-nav a:hover,.primary-nav a.active { color:var(--green); }
    .primary-nav a.active:after { content:""; position:absolute; left:0; right:0; bottom:0; height:3px; border-radius:3px 3px 0 0; background:var(--green); }
    .courses-link.active:after { display:none; }
    .header-actions { display:flex; align-items:center; gap:14px; white-space:nowrap; }
    .user-name { max-width:170px; overflow:hidden; text-overflow:ellipsis; font-size:13px; color:var(--muted); }
    .user-avatar { cursor:pointer; background:var(--green)!important; transition:transform .2s ease; }
    .user-avatar:hover { transform:scale(1.06); }
    .login-link,.signup-link { padding:9px 14px; font-weight:650; text-decoration:none!important; border-radius:8px; }
    .login-link { color:var(--ink)!important; }
    .signup-link { color:white!important; background:var(--green); }
    .signup-link:hover { background:var(--green-dark); transform:translateY(-1px); }
    .admin-nav { min-height:44px; display:flex; align-items:center; justify-content:center; gap:24px; padding:7px 20px; background:#17211b; color:white; font-size:13px; }
    .admin-nav span { color:#a8b4ad; text-transform:uppercase; font-size:10px; font-weight:800; letter-spacing:1.3px; }
    .admin-nav a { color:#e9eeeb; text-decoration:none; }
    .admin-nav a:hover,.admin-nav a.active { color:#8fe0b3; }
    .page-content { min-height:calc(100vh - 72px); }
    @@media(max-width:860px){ .topbar-inner{padding:0 16px;gap:18px}.primary-nav{gap:18px;overflow-x:auto}.primary-nav a{font-size:13px}.user-name{display:none} }
    @@media(max-width:640px){ .topbar{height:auto}.topbar-inner{height:64px;flex-wrap:wrap}.primary-nav{position:absolute;top:64px;left:0;right:0;height:46px;padding:0 16px;background:white;border-bottom:1px solid var(--line)}.page-content{padding-top:46px}.primary-nav a{height:46px}.brand{font-size:19px}.brand-mark{width:32px;height:32px}.login-link{display:none}.signup-link{padding:8px 11px} }
</style>
